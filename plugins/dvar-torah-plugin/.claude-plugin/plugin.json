{
  "name": "dvar-torah-plugin",
  "version": "1.1.0",
  "description": "Write Dvar Torah, posts, and shiurim across all major Jewish thought streams — philosophy, kabbalah, hasidut, hazal, and modern scholars. Powered by Sefaria MCP (bundled) and an optional bundled Gemini MCP server for prose drafting.",
  "author": {
    "name": "yodem",
    "url": "https://github.com/yodem"
  },
  "homepage": "https://github.com/yodem/Dvar-Torah-Plugin",
  "repository": "https://github.com/yodem/Dvar-Torah-Plugin",
  "license": "MIT",
  "keywords": [
    "jewish-philosophy",
    "dvar-torah",
    "sefaria",
    "rambam",
    "kabbalah",
    "hasidut",
    "hazal",
    "mussar",
    "jewish-thought",
    "shiur",
    "torah",
    "gemini"
  ],
  "skills": "./skills/",
  "commands": "./commands/",
  "hooks": "./hooks/hooks.json",
  "mcpServers": {
    "gemini-api": {
      "command": "node",
      "args": ["${CLAUDE_PLUGIN_ROOT}/mcp/gemini-server/dist/index.js"],
      "env": {
        "GOOGLE_API_KEY": "${GOOGLE_API_KEY}",
        "CLAUDE_PROJECT_DIR": "${CLAUDE_PROJECT_DIR}",
        "CLAUDE_PLUGIN_ROOT": "${CLAUDE_PLUGIN_ROOT}"
      }
    }
  }
}
